{
  "name": "@uspaya/database",
  "version": "0.0.0",
  "private": true,
  "main": "dist/src/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "pnpm prisma:generate && tsc -p tsconfig.json",
    "typecheck": "pnpm prisma:generate && tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && node --test dist/src/idempotency.spec.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "seed": "pnpm build && node dist/scripts/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0"
  },
  "devDependencies": {
    "prisma": "6.19.0"
  }
}
